; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Caravan Thief"
config/description="Sword Stories: The Caravan Thief. A heist JRPG about a thief, a cursed sword, and the difference between taking something and owning it."
config/version="0.3.15"
run/main_scene="res://scenes/shell.tscn"
config/features=PackedStringArray("4.6")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.106, 0.075, 0.125, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout=""

[autoload]

Art="*res://scripts/art.gd"
Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.106, 0.075, 0.125, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
